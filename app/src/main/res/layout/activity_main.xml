<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/Page_accueil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/Texte_indication"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Indiquez le nombre de joueurs (1 à 4)"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/Input_nb_joueur"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:hint="Ex: 2"
            android:inputType="number" />

        <Button
            android:id="@+id/Bouton_nb_joueur"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="Valider" />

        <EditText
            android:id="@+id/Input_Nom_J1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Player 1 : Name"
            android:visibility="gone" />

        <EditText
            android:id="@+id/Input_Nom_J2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Player 2 : Name"
            android:visibility="gone" />

        <EditText
            android:id="@+id/Input_Nom_J3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Player 3 : Name"
            android:visibility="gone" />

        <EditText
            android:id="@+id/Input_Nom_J4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Player 4 : Name"
            android:visibility="gone" />

        <Button
            android:id="@+id/Bouton_next"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginTop="32dp"
            android:text="Next" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/Layer_1_Joueur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/Bouton_Layer_1"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="Choisir une playlist" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/Layer_2_Joueurs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/Bouton_Layer_2"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="Choisir une playlist" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/Layer_3_Joueurs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/Bouton_Layer_3"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="Choisir une playlist" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/Layer_4_Joueurs"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/Bouton_Layer_4"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:text="Choisir une playlist" />
    </LinearLayout>

</FrameLayout>